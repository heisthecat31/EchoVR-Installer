<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/dialog_background"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-condensed"
        android:text="Settings"
        android:textColor="@color/echo_text"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:letterSpacing="0.08"
        android:text="ECHO VR UPDATES"
        android:textColor="@color/echo_text_dim"
        android:textSize="12sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/segment_track_background"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/channelStable"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="STABLE"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/channelBeta"
            android:layout_width="0dp"
            android:layout_height="44dp"
            android:layout_weight="1"
            android:fontFamily="sans-serif-condensed"
            android:gravity="center"
            android:text="BETA"
            android:textSize="15sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/channelDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/echo_text_dim"
        android:textSize="13sp" />

    <Button
        android:id="@+id/settingsDone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@drawable/button_background"
        android:fontFamily="sans-serif-condensed"
        android:text="DONE"
        android:textColor="@color/echo_text"
        android:textSize="14sp"
        android:textStyle="bold"
        app:backgroundTint="@null" />

</LinearLayout>
